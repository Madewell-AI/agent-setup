[Unit]
Description=Maia Slack Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Default paths assume 'maia' user — update if your username is different
ExecStart=/home/maia/.nvm/versions/node/v22.22.1/bin/node /home/maia/agent-setup/shared/slack-bot/bot.js
WorkingDirectory=/home/maia/agent-setup/shared/slack-bot
Restart=always
RestartSec=5
Environment=HOME=/home/maia
Environment=PATH=/home/maia/.nvm/versions/node/v22.22.1/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
