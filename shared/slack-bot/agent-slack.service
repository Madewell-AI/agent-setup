[Unit]
Description=Maia Slack Bot (Socket Mode)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
# Default paths assume 'maia' user — update USERNAME and paths to match your setup
ExecStart=/home/maia/.nvm/versions/node/v22.22.1/bin/node /home/maia/agent-setup/shared/slack-bot/bot.js
WorkingDirectory=/home/maia/agent-setup/shared/slack-bot
# EnvironmentFile ensures CLAUDE_CODE_OAUTH_TOKEN (and other creds) are inherited
# by all claude -p subprocess calls the bot spawns — without this, subprocesses
# will 401 when the interactive session token doesn't carry over.
EnvironmentFile=/home/maia/.agent/.env
Restart=always
RestartSec=3
TimeoutStopSec=300
Environment=HOME=/home/maia
Environment=TMPDIR=/tmp
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/maia/.nvm/versions/node/v22.22.1/bin:/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:/usr/local/bin:/usr/bin:/bin
StandardOutput=journal
StandardError=journal
SyslogIdentifier=maia-slack
NoNewPrivileges=yes

[Install]
WantedBy=default.target
